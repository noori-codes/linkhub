# Copy to .env and fill in.

# --- Local MinIO (recommended for learning — no credit card) ---
# 1) Terminal A: ./scripts/start-minio.sh
# 2) Terminal B: ./scripts/init-minio-bucket.sh   (once)
# 3) Restart the API (yarn dev in api/)
S3_BUCKET=linkhub
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_ENDPOINT=http://127.0.0.1:9000
S3_PUBLIC_URL=http://127.0.0.1:9000/linkhub

# --- Cloudflare R2 / AWS (later, when you have billing) ---
# S3_BUCKET=
# S3_REGION=auto
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
# S3_PUBLIC_URL=https://pub-xxxxx.r2.dev
