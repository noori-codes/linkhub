# Copy to .env and fill in. Works with AWS S3, Cloudflare R2, or MinIO.

# S3-compatible object storage (avatar uploads)
S3_BUCKET=linkhub
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Required for R2 / MinIO. Leave empty for real AWS S3.
# R2 example: https://<ACCOUNT_ID>.r2.cloudflarestorage.com
S3_ENDPOINT=
# Public base URL for reading objects (no trailing slash)
# R2 public bucket / custom domain, or https://bucket.s3.region.amazonaws.com
S3_PUBLIC_URL=
